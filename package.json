{
  "name": "sayed-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "next dev -p 3000 --turbo",
    "dev:webpack": "next dev -p 3000",
    "dev:fresh": "sh -c 'p=$(lsof -ti:3000 2>/dev/null); [ -n \"$p\" ] && kill -9 $p; exec next dev -p 3000 --turbo'",
    "dev:clean": "npm run clean && next dev -p 3000 --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.27.3",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
